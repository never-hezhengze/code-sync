rlnorm_transform <- function(n, mu, sigma){
x <- rnorm(n, mean = mu, sd = sigma)
y <- exp(x)
return(y)
}
set.seed(123)
n <- 1000
mu <- 0
sigma <- 1
sample_ln <- rlnorm_transform(n, mu, sigma)
# 直方图（概率密度）
hist(sample_ln, probability = TRUE,
breaks = 30,
col = "lightblue",
main = "Lognormal Sample Histogram",
xlab = "x")
# 叠加理论密度曲线
curve(dlnorm(x, meanlog = mu, sdlog = sigma),
col = "red", lwd = 2, add = TRUE)
set.seed(123)
n <- 200
mu <- c(0, 1, 2)
Sigma <- matrix(c(
1, -0.5, 0.5,
-0.5, 1, -0.5,
0.5, -0.5, 1
), nrow = 3, byrow = TRUE)
# Cholesky分解
L <- chol(Sigma)
# 标准正态
Z <- matrix(rnorm(n * 3), nrow = n)
# 生成样本
X1 <- Z %*% L + matrix(mu, n, 3, byrow = TRUE)
# 散点矩阵
pairs(X1, main = "Cholesky Method")
