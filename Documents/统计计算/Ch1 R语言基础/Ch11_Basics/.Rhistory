### Example  (Inverse transform method, Geometric)
n = 1000
p = 0.4
u = runif(n)
# Method 1
k = ceiling(log(1-u) / log(1-p))
k
# Method 2
mean(k)
var(k)
k = floor(log(u) / log(1-p))+1
k
mean(k)
var(k)
