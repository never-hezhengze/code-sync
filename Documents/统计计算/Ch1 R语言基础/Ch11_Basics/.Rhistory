f <- function(x) {
x^3 - 2*x - 5
}
# 二分法
bisect <- function(f, a, b, tol = 1e-8, maxiter = 100) {
fa <- f(a)
fb <- f(b)
if (fa * fb > 0) {
stop("区间两端函数值同号，不能使用二分法")
}
for (i in 1:maxiter) {
c <- (a + b) / 2
fc <- f(c)
if (abs(fc) < tol || (b - a) / 2 < tol) {
return(list(root = c, value = fc, iter = i))
}
if (fa * fc < 0) {
b <- c
fb <- fc
} else {
a <- c
fa <- fc
}
}
return(list(root = c, value = fc, iter = maxiter))
}
bisect(f, 2, 3)
f <- function(x) {
-x^2 + x + 1/4
}
df <- function(x) {
-2*x + 1
}
ddf <- function(x) {
-2
}
x <- 0
for (i in 1:10) {
x_new <- x - df(x) / ddf(x)
if (abs(x_new - x) < 1e-8) {
break
}
x <- x_new
}
x
f(x)
f <- function(x) {
-x^2 + x + 1/4
}
result <- optimize(f, interval = c(-10, 10), maximum = TRUE)
result
library(stats4)
x <- c(2, 3, 4, 1, 2, 5, 3, 2, 4, 3)
# 负对数似然函数
nll <- function(lambda) {
-sum(dpois(x, lambda = lambda, log = TRUE))
}
# 用 mle 求极大似然估计
fit <- mle(nll, start = list(lambda = mean(x)))
summary(fit)
coef(fit)
