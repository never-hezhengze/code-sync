##  Monte Carlo method for estimation of pi
jpeg("fig1.jpeg", height=800, width=800, quality = 100)
px = seq(0, 1, 0.01)
py = sqrt(1-px^2)
plot(px, py, type="l", axes=F, xlab="", ylab="")
segments(0, 1, 1, 1)
segments(1, 0, 1, 1)
segments(0, 0, 0, 1)
segments(0, 0, 1, 0)
polygon(c(px,1,0,0), c(py,0,0,1), col="gray")
text(0.5, 0.5, expression(frac(pi^2,4)), col="red")
dev.off()
n = 1e5
x = runif(n)
y = runif(n)
k = (x^2+y^2<=1)
pi.hat = 4*sum(k)/n
pi.hat
jpeg("fig2.jpeg", height=800, width=800, quality = 100)
px = seq(0, 1, 0.01)
py = sqrt(1-px^2)
plot(px, py, type="l", axes=F, xlab="", ylab="")
segments(0, 1, 1, 1)
segments(1, 0, 1, 1)
segments(0, 0, 0, 1)
segments(0, 0, 1, 0)
points(x[k], y[k], pch=".", col="red")
points(x[!k], y[!k], pch=".", col="blue")
dev.off()
