%% 第一题
t = -4*pi:0.1:4*pi;
xt = @(t) exp(t) .* cos(t);
yt = @(t) exp(t) .* sin(t);
fplot(xt,yt);

%% 第二题
[X,Y] = meshgrid(-3:.1:3);
Z = -X.^2/10 + Y.^2/10;
surf(X,Y,Z);

%% 第三题
[X,Y] = meshgrid(-4:0.1:4);
/*Z = exp(abs(X+Y))./(X+Y);
surf(X,Y,Z);*/
Z_num = exp(abs(X + Y));
Z_den = X + Y;
% 将分母为0的部分设为NaN
Z_den(Z_den == 0) = NaN;
Z = Z_num ./ Z_den;
Z(isinf(Z)) = NaN;
surf(X,Y,Z);
zlim([-20 20]); % 截断过高的山峰