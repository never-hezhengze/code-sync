<mxfile host="draw.io"><diagram name="Q2-flow" id="fq2"><mxGraphModel dx="900" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="900" pageHeight="720" background="none" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="&lt;b&gt;设定产能参数&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#888;&quot;&gt;产能72吨/日, 按9吨递减至36吨&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F4FA;strokeColor=#7B9FC0;strokeWidth=1.5;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="10" width="280" height="42" as="geometry"/></mxCell><mxCell id="e1" edge="1" parent="1" style="rounded=1;html=1;strokeWidth=1.5;strokeColor=#999999;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="52" as="sourcePoint"/><mxPoint x="340" y="75" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n2" value="&lt;b&gt;遍历每种日产量&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#888;&quot;&gt;72, 63, 54, 45, 36 吨/日&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E8B860;strokeWidth=1.5;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="75" width="280" height="42" as="geometry"/></mxCell><mxCell id="e2" edge="1" parent="1" style="rounded=1;html=1;strokeWidth=1.5;strokeColor=#999999;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="117" as="sourcePoint"/><mxPoint x="340" y="140" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n3" value="&lt;b&gt;计算所需运行时段数&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#888;&quot;&gt;运行小时 = 日产量 / (1.5吨/h)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AAA7A;strokeWidth=1.5;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="140" width="280" height="