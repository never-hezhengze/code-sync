<mxfile host="draw.io"><diagram name="Q3-flow" id="fq3"><mxGraphModel dx="900" dy="680" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="900" pageHeight="680" background="none" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="&lt;b&gt;设定连续调节参数&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#888;&quot;&gt;功率下限10%, 产能72→36吨/日&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F4FA;strokeColor=#7B9FC0;strokeWidth=1.5;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="10" width="280" height="42" as="geometry"/></mxCell><mxCell id="e1" edge="1" parent="1" style="rounded=1;html=1;strokeWidth=1.5;strokeColor=#999999;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="52" as="sourcePoint"/><mxPoint x="340" y="75" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n2" value="&lt;b&gt;遍历24种风光场景&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#888;&quot;&gt;6种风电×4种光伏出力组合&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E8B860;strokeWidth=1.5;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="75" width="280" height="42" as="geometry"/></mxCell><mxCell id="e2" edge="1" parent="1" style="rounded=1;html=1;strokeWidth=1.5;strokeColor=#999999;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="117" as="sourcePoint"/><mxPoint x="340" y="140" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n3" value="&lt;b&gt;★ 构建线性规划模型&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#3D5A80;&quot;&gt;目标: min 吨氨成本&lt;br&gt;决策变量: 每时段制氢氨功率&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#3D5A80;strokeWidth=2.5;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="170" y="140" width