<mxCell id="g3b" value="&lt;font style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;问题四：离网+储能优化&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0ECF8;strokeColor=#6c8ebf;strokeWidth=1.2;fontSize=10;fontStyle=1;verticalAlign=top;spacingTop=2;arcSize=8;" vertex="1" parent="1"><mxGeometry x="495" y="365" width="310" height="120" as="geometry"/></mxCell><mxCell id="n3d" value="&lt;b&gt;离网运行仿真&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;color:#666;&quot;&gt;风光自给约束下制氨&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;strokeWidth=1.2;fontSize=10;fontStyle=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="505" y="393" width="140" height="38" as="geometry"/></mxCell><mxCell id="n3e" value="&lt;b&gt;储能容量配置&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;color:#666;&quot;&gt;最大弃电场景优化&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;strokeWidth=1.2;fontSize=10;fontStyle=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="655" y="393" width="140" height="38" as="geometry"/></mxCell><mxCell id="n3f" value="&lt;b&gt;经济性对比&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;color:#666;&quot;&gt;离网vs联网成本分析&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;strokeWidth=1.2;fontSize=10;fontStyle=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="560" y="443" width="180" height="38" as="geometry"/></mxCell><mxCell id="R3" value="&lt;b&gt;线性规划&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;color:#555;&quot;&gt;scipy.optimize&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;储能仿真&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;color:#555;&quot;&gt;SOC状态转移&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4EDDA;gradientColor=#C0E0C8;strokeColor=#82b366;strokeWidth=1.2;fontSize=10;fontStyle=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="845" y="365" width="120" height="120" as="geometry"/></mxCell><mxC