<mxfile host="draw.io"><diagram name="Q4-flow" id="fq4"><mxGraphModel dx="900" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="900" pageHeight="720" background="none" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="&lt;b&gt;离网运行模式设定&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:9px;color:#888;&amp;quot;&gt;无外部电网, 风光自给, 产能72吨/日&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F4FA;strokeColor=#7B9FC0;strokeWidth=1.5;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="190" y="10" width="300" height="42" as="geometry"/></mxCell><mxCell id="e1" edge="1" parent="1" style="rounded=1;html=1;strokeWidth=1.5;strokeColor=#999999;endArrow=block;endFill=1;exitX=0.25;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"><mxPoint x="265" y="52" as="sourcePoint"/><mxPoint x="170" y="80" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e1b" edge="1" parent="1" style="rounded=1;html=1;strokeWidth=1.5;strokeColor=#999999;endArrow=block;endFill=1;exitX=0.75;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"><mxPoint x="415" y="52" as="sourcePoint"/><mxPoint x="510" y="80" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n2a" value="&lt;b&gt;(1) 无储能离网分析&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:9px;color:#888;&amp;quot;&gt;风光直接供电制氢氨&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E8B860;strokeWidth=1.5;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="80" width="240" height="42" as="geometry"/></mxCell><mxCell id="n2b" value="&lt;b&gt;(2) 储能配置优化&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:9px;color:#888;&amp;quot;&gt;最大弃电场景储能容量&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E8B860;strokeWidth=1.5;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="390" y="80" width="240" height="42" as="geometry"/></mxCell><mxCell id="e2a" edge="1" parent="1" style="rounded=1;html=1;strokeWidth=1.5;strokeColor=#999999;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="122" as="sourcePoint"/><mxPoint x="170" y="148" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e2b" edge="1" parent="1" style="rounded=1;html=1;strokeWidth=1.5;strokeColor=#999999;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="122" as="sourcePoint"/><mxPoint x="510" y="148" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n3a" value="&lt;b&gt;逐时段功率匹配&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:9px;color:#888;&amp;quot;&gt;制氢氨功率不超过风光净出力&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AAA7A;strokeWidth=1.5;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="148" width="280" height="42" as="geometry"/></mxCell><mxCell id="n3b" value="&lt;b&gt;识别最大弃电场景&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:9px;color:#888;&amp;quot;&gt;弃电量 = 风光出力 - 可用负荷&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7AAA7A;strokeWidth=1.5;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="370" y="148" width="280" height="42" as="geometry"/></mxCell><mxCell id="e3a" edge="1" parent="1" style="rounded=1;html=1;strokeWidth=1.5;strokeColor=#999999;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="190" as="sourcePoint"/><mxPoint x="170" y="216" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e3b" edge="1" parent="1" style="rounded=1;html=1;strokeWidth=1.5;strokeColor=#999999;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="190" as="sourcePoint"/><mxPoint x="510" y="216" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n4a" value="&lt;b&gt;计算各场景制氨产量&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:9px;color:#888;&amp;quot;&gt;产量 = 累计制氨功率 / 单位能耗&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9A8AB0;strokeWidth=1.5;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="216" width="280" height="42" as="geometry"/></mxCell><mxCell id="n4b" value="&lt;b&gt;储能容量优化模型&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:9px;color:#3D5A80;&amp;quot;&gt;min弃电 s.t. SOC约束+充放电功率&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#3D5A80;strokeWidth=2.5;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="370" y="216" width="280" height="42" as="geometry"/></mxCell><mxCell id="e4a" edge="1" parent="1" style="rounded=1;html=1;strokeWidth=1.5;strokeColor=#999999;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="258" as="sourcePoint"/><mxPoint x="170" y="284" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e4b" edge="1" parent="1" style="rounded=1;html=1;strokeWidth=1.5;strokeColor=#999999;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="258" as="sourcePoint"/><mxPoint x="510" y="270" as="targetPoint"/></mxGeometry></mxCell><mxCell id="dec4" value="&lt;b&gt;弃电量是否&lt;br&gt;超过阈值?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F5F0E8;strokeColor=#B0A080;strokeWidth=1.5;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="445" y="270" width="130" height="65" as="geometry"/></mxCell><mxCell id="edec4y" edge="1" parent="1" style="rounded=1;html=1;strokeWidth=1.5;strokeColor=#7AAA7A;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="335" as="sourcePoint"/><mxPoint x="510" y="350" as="targetPoint"/></mxGeometry></mxCell><mxCell id=