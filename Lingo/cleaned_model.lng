model :

! 决策变量定义：;
! P(t): 生产量，O(t): 外包量，I(t): 库存量，B(t): 缺货量;
! H(t): 工人数，E(t): 雇佣人数，F(t): 解雇人数;
! Tn(t): 正常工时，To(t): 加班工时，S(t): 实际销售量;

sets :
t/1..7/: P, O, I, B, H, E, F, Tn, To, D, S;
endsets

! 参数定义;
w = 300;     ! 产品售价;
c = 90;      ! 原材料单价;
sn = 30;     ! 正常工时工资;
so = 40;     ! 加班工时工资;
oc = 200;    ! 外包成本;
ic = 15;     ! 库存成本;
bc = 35;     ! 缺货成本;
Ec = 5000;   ! 雇佣成本;
Fc = 8000;   ! 解雇成本;
th = 5;      ! 工时（每件）;

data :
D = 0,20000,40000,42000,35000,19000,18500;
enddata
I(1) = 15000; ! 初始库存;
H(1) = 1000;  ! 初始工人;

!目标函数;
max  =  @SUM (t(k) | k #GE# 1:
(w * S(k)
- c * P(k)
- sn * Tn(k)
- so * To(k)
- oc * O(k)
- ic * I(k)
- bc * B(k)
- Ec * E(k)
- Fc * F(k))
);

! 实际销售量定义;
@for(t(k)| k #GT# 1:
  S(k) = @smin(D(k),I(k-1)+P(k)+O(k));
);
S(1) = 0;

!产能与工时约束;
@for (t(k): P(k) = (Tn(k) + To(k))/th;);
@for (t(k): Tn(k) = 160 * H(k););
@for (t(k): To(k) <= 20 * H(k););

!库存平衡;
@for (t(k) | k #GT# 1:
I(k) = I(k-1) + P(k) + O(k) - S(k) + B(k)
);

!工人数目约束;
@for (t(k)|k #GT# 1: H(k) = H(k-1) + E(k) - F(k););
I(7) >= 10000;

@for (t(k): B(k) <= D(k););

@for (t(k):  @GIN (H(k)));
@for (t(k):  @GIN (E(k)));
@for (t(k):  @GIN (F(k)));
@for (t(k):  Tn(k) >= 0;);
@for (t(k):  To(k) >= 0;);
@for (t(k):  B(k) >= 0;);
@for (t(k):  P(k) >= 0;);
@for (t(k):  O(k) >= 0;);
@for (t(k):  I(k) >= 0;);
@for (t(k):  S(k) >= 0;);

end